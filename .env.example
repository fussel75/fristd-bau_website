# Payload CMS — Konfiguration
# Werte werden zur Runtime aus diesen Variablen gelesen.

# Geheimer Schluessel fuer JWT-Signierung. 32+ Zeichen, zufaellig.
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Pfad zur SQLite-DB (relativ zum Container-Root oder Projekt-Root)
DATABASE_URI=file:./data/payload.db

# Oeffentlicher URL der Site (fuer Cookies, Mails, Self-Links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend API-Key fuer den Mail-Versand aus dem Widerrufsformular.
# Anmeldung + Key erzeugen: https://resend.com/api-keys
# Ohne Key wird das Formular eine 503-Fehlermeldung anzeigen.
RESEND_API_KEY=

# Absender-Adresse (muss bei Resend fuer die Domain verifiziert sein).
# Fallback: onboarding@resend.dev (nur zum Testen, sendet nur an Account-Owner).
RESEND_FROM="FriStD-Bau Website <post@fristd-bau.com>"

# Empfaenger der Widerrufserklaerungen. Default: post@fristd-bau.com
WIDERRUF_TO=post@fristd-bau.com
