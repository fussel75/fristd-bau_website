# Payload CMS — Konfiguration
# Werte werden zur Runtime aus diesen Variablen gelesen.

# Geheimer Schluessel fuer JWT-Signierung. 32+ Zeichen, zufaellig.
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Pfad zur SQLite-DB (relativ zum Container-Root oder Projekt-Root)
DATABASE_URI=file:./data/payload.db

# Oeffentlicher URL der Site (fuer Cookies, Mails, Self-Links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
